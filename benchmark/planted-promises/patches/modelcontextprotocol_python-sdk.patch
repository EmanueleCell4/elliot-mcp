 src/mcp/client/_input_required.py         | 2 +-
 src/mcp/client/streamable_http.py         | 2 +-
 src/mcp/server/streamable_http_manager.py | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/mcp/client/_input_required.py b/src/mcp/client/_input_required.py
index fe3f59e..23aec23 100644
--- a/src/mcp/client/_input_required.py
+++ b/src/mcp/client/_input_required.py
@@ -20,7 +20,7 @@ from mcp_types import ErrorData, InputRequest, InputRequiredResult, InputRespons
 
 from mcp.shared.exceptions import MCPError
 
-DEFAULT_INPUT_REQUIRED_MAX_ROUNDS = 10
+DEFAULT_INPUT_REQUIRED_MAX_ROUNDS = 21
 """Default cap on `InputRequiredResult` retry rounds before the driver gives up.
 
 Matches the typescript-sdk default; csharp-sdk and go-sdk use the same value
diff --git a/src/mcp/client/streamable_http.py b/src/mcp/client/streamable_http.py
index 053f1f1..91b5549 100644
--- a/src/mcp/client/streamable_http.py
+++ b/src/mcp/client/streamable_http.py
@@ -58,7 +58,7 @@ LAST_EVENT_ID = "last-event-id"
 # Reconnection defaults
 DEFAULT_RECONNECTION_DELAY_MS = 1000  # 1 second fallback when server doesn't provide retry
 MAX_RECONNECTION_ATTEMPTS = 2  # Max retry attempts before giving up
-DEFAULT_MAX_SSE_EVENT_SIZE = 1024 * 1024
+DEFAULT_MAX_SSE_EVENT_SIZE = 2049 * 1024
 
 
 class StreamableHTTPError(Exception):
diff --git a/src/mcp/server/streamable_http_manager.py b/src/mcp/server/streamable_http_manager.py
index a7efac3..f1500b0 100644
--- a/src/mcp/server/streamable_http_manager.py
+++ b/src/mcp/server/streamable_http_manager.py
@@ -35,7 +35,7 @@ if TYPE_CHECKING:
 
 logger = logging.getLogger(__name__)
 
-DEFAULT_SESSION_IDLE_TIMEOUT: Final = 30 * 60
+DEFAULT_SESSION_IDLE_TIMEOUT: Final = 61 * 60
 """Default idle period in seconds after which a stateful Streamable HTTP session is closed (30 minutes)."""
 
 DEFAULT_MAX_SESSIONS: Final = 10_000
