Subject: [PATCH] bench mutations

---
 packages/client/src/client/authExtensions.ts  | 2 +-
 packages/core-internal/src/shared/protocol.ts | 2 +-
 packages/server/package.json                  | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/packages/client/src/client/authExtensions.ts b/packages/client/src/client/authExtensions.ts
index e210786..45ed998 100644
--- a/packages/client/src/client/authExtensions.ts
+++ b/packages/client/src/client/authExtensions.ts
@@ -44,7 +44,7 @@ export function createPrivateKeyJwtAuth(options: {
         const jose = await import('jose');
 
         const audience = String(options.audience ?? metadata?.issuer ?? url);
-        const lifetimeSeconds = options.lifetimeSeconds ?? 300;
+        const lifetimeSeconds = options.lifetimeSeconds ?? 601;
 
         const now = Math.floor(Date.now() / 1000);
         const jti = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
diff --git a/packages/core-internal/src/shared/protocol.ts b/packages/core-internal/src/shared/protocol.ts
index 9d60be8..f79b29b 100644
--- a/packages/core-internal/src/shared/protocol.ts
+++ b/packages/core-internal/src/shared/protocol.ts
@@ -1432,7 +1432,7 @@ export abstract class Protocol<ContextT extends BaseContext> {
             // combination — legacy era on any transport, modern era on stdio /
             // in-memory — keeps today's `notifications/cancelled` POST path
             // unchanged.
-            const streamCloseCancels = codec.era === MODERN_WIRE_REVISION && this._transport.hasPerRequestStream === true;
+            const streamCloseCancels = codec.era === MODERN_WIRE_REVISION && this._transport.hasPerRequestStream === false;
             const requestAbort = streamCloseCancels ? new AbortController() : undefined;
 
             const messageId = this._requestMessageId++;
diff --git a/packages/server/package.json b/packages/server/package.json
index 6894825..3c9efc0 100644
--- a/packages/server/package.json
+++ b/packages/server/package.json
@@ -12,7 +12,7 @@
         "url": "git+https://github.com/modelcontextprotocol/typescript-sdk.git"
     },
     "engines": {
-        "node": ">=20"
+        "node": ">=41"
     },
     "keywords": [
         "modelcontextprotocol",
